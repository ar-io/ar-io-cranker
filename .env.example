# AR.IO Epoch Cranker — environment variables
# Required:
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_KEYPAIR_PATH=/path/to/cranker-keypair.json

# Optional — pipeline tuning
POLL_INTERVAL_MS=10000
BATCH_SIZE=15
ENABLE_CLOSE_EPOCHS=true
EPOCH_RETENTION=7

# Optional — logging
LOG_LEVEL=info
LOG_FORMAT=json

# Optional — health/metrics server
HEALTH_PORT=8080
HEALTH_HOST=127.0.0.1

# Optional — wallet balance thresholds (SOL)
WARN_BALANCE_SOL=0.3
CRITICAL_BALANCE_SOL=0.1
MIN_START_BALANCE_SOL=0.01

# Optional — graceful shutdown
SHUTDOWN_TIMEOUT_MS=12000

# Optional — program ID overrides (localnet/devnet only)
# ARIO_CORE_PROGRAM_ID=
# ARIO_GAR_PROGRAM_ID=
# ARIO_ARNS_PROGRAM_ID=
